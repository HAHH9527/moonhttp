import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/core/debug",
  "hahh9527/moonhttp/core",
  "hahh9527/moonhttp/internal/fixtures",
  "moonbitlang/core/test",
}

// 作用域实证结论（R9 前置事项，2026-10-21 实测）：本版本 moon 仅存在
// "test"（黑盒）作用域，`for "wbtest"` 非法——白盒（_wbtest.mbt）只能
// 经常规 import 取得依赖（黑盒另有专属作用域）。故 @fixtures 与 @test
// （白盒 FR② 的 expect_error 断言面）走常规导入：二者仅被测试用例引用
// （黑盒 US/E + 白盒 FR⑧/T018 长跑），池运行时零引用，lib 编译单元的
// unused_package 警告随之出现，在下方 warnings 显式抑制。
//
// T022 复核移除（2026-10-21）：骨架期临时抑制 unused_field/
// struct_never_constructed 已移除——复核确认池实体字段全部有读写点、
// 五结构全部有构造点（T005/T006/T009/T012 接入完毕），后续新增字段/
// 结构须自带读写点，不再整包抑制；unused_package 保留（作用域实证
// 理由见上：@fixtures/@test 仅测试引用所致，运行时依赖方向不变：
// client → async/http）。
//
// P05（2026-10-25）增补 -reserved_keyword：`method` 是 P01 Method 与
// fixtures RequestLineExpect 的冻结字段名（contracts/request.md、
// fixtures-api.md），同时是 MoonBit 保留字——构造字面量处触发 [0035]
// （core 包同名先例：src/core/moon.pkg T020 口径）。按包级配置精确
// 关闭该警告，其余警告不受影响。

options(
  warnings: "-unused_package",
)

pkgtype(kind: "library")
