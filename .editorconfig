root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[{moon.mod.json,moon.pkg.json}]
indent_size = 2

# 构建产物与 vendored 上游依赖：不施加约定，避免与上游风格/`moon fmt` 打架
[_build/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[.mooncakes/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
