// P03 测试夹具库（specs/003-m1-p03-test-fixtures）：两类可控服务端——
// 第 1 类 @http 声明式编排服务端（scripted_server，B-01～B-06/B-08）、
// 第 2 类裸 TCP 程序化对端（raw_peer → ScriptedPeer 演进，B-09～B-13），
// 外加端口/生命周期驱动辅助（B-14/B-15）。
//
// 宪法 I：只经 moonbitlang/async 公开 API（@http / @socket / @io / @async），
// 不 fork、不复制、不 vendor 上游源码；上游 test_programs/examples/mio 测试资产
// 一律不搬运（roadmap 差异 D8），手法可参考、代码自建。上游代码禁改。
// 宪法 IV：只监听/连接 127.0.0.1（回环），绝不触外部网络。
// 宪法 VII：注释与文档中文。

import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/socket",
}

// 黑盒测试（*_test.mbt）的错误分类面需要 @io（B-11 钉死集合的 ReaderClosed
// 判别）；仅测试可见，不进入夹具运行时依赖。
import {
  "moonbitlang/async/io",
} for "test"

// RequestLineExpect 的字段名 `method` 与 contracts/fixtures-api.md §3 契约
// 一致（断言面语义：method/target），与保留字冲突——按 core/moon.pkg 先例
// 做包级显式抑制（有理由例外；其余警告不受影响，T021 落点）。

options(
  warnings: "-reserved_keyword",
)

pkgtype(kind: "library")
