// `method` 是 spec FR-002 冻结契约的五要素字段/方法名（contracts/request.md），
// 同时是 MoonBit 保留字——使用处触发 [0035]（reserved_keyword，解析期警告，
// 声明级 #warnings 属性无法抑制）。按包级配置精确关闭该警告（T020 零警告
// 门的显式、有理由例外；其余警告不受影响）。
options(
  warnings: "-reserved_keyword",
)

import {
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/core/encoding/utf8",
}

// 黑盒测试（*_test.mbt）的 async test / @async.with_task_group 基础设施
// （T013 生命周期三路径与 T015 进度回调的异步测试所需；任务 T001 落点），
// 以及 T009 线上字节断言的 P03 裸 TCP 对端夹具（wire_form_test.mbt；仅测试
// 可见，不进入 core 运行时依赖——public 面零变化，pkg.generated.mbti 零 diff）。
// 夹具宿主 src/internal/fixtures（P03 C1 裁决，specs/003-m1-p03-test-fixtures
// /plan.md 收尾事项 3：src/fixtures 为历史路径锚点，映射以此为准）。
import {
  "moonbitlang/async",
  "hahh9527/moonhttp/internal/fixtures",
} for "test"

pkgtype(kind: "library")
